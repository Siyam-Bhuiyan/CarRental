{
  "expo": {
    "name": "Car Rental",
    "slug": "car-rental",
    "scheme": "carrental",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030303",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.carrental.assessment"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030303",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.carrental.assessment"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.carrental.assessment",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9a947aa-771e-4de3-801e-9b9541f928b0"
      }
    },
    "owner": "siyambhuiyan294"
  }
}
