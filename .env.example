# Stripe TEST-mode keys (https://dashboard.stripe.com/test/apikeys).
# Copy this file to `.env`, fill in the values, then restart Expo with `npx expo start -c`.
# Leave them empty to run payments in demo mode.
# Publishable key starts with pk_test_ ; secret key starts with sk_test_.
# Never use live keys here - these variables are bundled into the app.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_SECRET_KEY=
